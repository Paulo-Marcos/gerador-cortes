# =============================================================================
# CortadorLive — Template de variáveis de ambiente para PRODUÇÃO (via terminal)
# =============================================================================
#
# Como usar:
#   1. Copie este arquivo para backend/.env no seu servidor de produção
#      (ou exporte cada variável como variável de sistema/serviço)
#   2. Preencha todos os valores marcados como OBRIGATÓRIO
#   3. Revise os valores opcionais conforme o seu setup
#   4. Copie canal_config.py.example → canal_config.py e edite com o conteúdo
#      do seu canal (nome, handle, crédito, prompts de contexto)
#
# Inicialização:
#   cd backend
#   python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
#
# =============================================================================

# -----------------------------------------------------------------------------
# IDENTIDADE DO CANAL                                          [via channel.yaml]
# -----------------------------------------------------------------------------
# Identidade do canal (handle/nome/crédito) e canal-fonte das lives
# (youtube_channel_id) são configurados por canal no channel.yaml do canal
# ativo (pela UI de Canais) — não aqui.
#
# NOME DO MASCOTE citado nos prompts de thumbnail/metadados — o nome do seu
# mascote. No primeiro boot semeia o `editorial/mascote.yaml` do canal ativo SE
# ainda não tiver `nome` — idempotente, nunca sobrescreve. Sem isto (e sem o
# yaml) a saída regride ao mascote NEUTRO ("mascote"). Este é o passo-chave do
# setup PROD: a PROD DEVE declarar aqui o nome do mascote do canal.
CANAL_MASCOTE_NOME=

# -----------------------------------------------------------------------------
# APIs EXTERNAS                                                [OBRIGATÓRIO]
# -----------------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui
YOUTUBE_API_KEY=sua_chave_youtube_api_aqui

# -----------------------------------------------------------------------------
# CAMINHOS DE ARQUIVOS                                        [opcional]
# -----------------------------------------------------------------------------
# Em produção, prefira caminhos absolutos para evitar ambiguidade.
# Padrão (relativo ao diretório backend/):
#   PROJETOS_DIR=./projetos
#   ASSETS_DIR=./assets
#
# Exemplo com caminhos absolutos:
# PROJETOS_DIR=/opt/cortadorlive/backend/projetos
# ASSETS_DIR=/opt/cortadorlive/backend/assets
# VIDEO_RENDERER_DIR=/opt/cortadorlive/video-renderer
# GUIA_CORTES_PATH=/opt/cortadorlive/backend/assets/GUIA_CRIACAO_CORTES.md

# -----------------------------------------------------------------------------
# DOWNLOAD DE VÍDEO (yt-dlp)                                  [opcional]
# -----------------------------------------------------------------------------
# Formato padrão de download — o valor abaixo é adequado para produção.
YTDLP_FORMAT=bestvideo+bestaudio/best

# -----------------------------------------------------------------------------
# CLAUDE CLI (provider alternativo de geração)                [opcional]
# -----------------------------------------------------------------------------
# Usa a assinatura local do Claude (sem custo por token).
# Requer o binário `claude` instalado e autenticado no servidor.
CLAUDE_CLI_ENABLED=true

# Caminho do binário claude (deixe vazio para resolver pelo PATH)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Diretório de trabalho das invocações claude -p
# Vazio = usa um diretório temporário (isola o CLAUDE.md do projeto)
# CLAUDE_CLI_CWD=

# Timeout por chamada em segundos (padrão: 300 = 5 minutos)
CLAUDE_CLI_TIMEOUT=300.0

# Máximo de chamadas simultâneas — 1 serializa e evita throttling da assinatura
CLAUDE_CLI_MAX_CONCURRENT=1

# Tentativas extras em erro transitório (overload/529); backoff exponencial
CLAUDE_CLI_RETRIES=4

# Extended thinking desabilitado globalmente (0 = desligado)
CLAUDE_CLI_MAX_THINKING_TOKENS=0

# Extended thinking habilitado só para geração de thumbnail (melhora qualidade)
CLAUDE_CLI_THINKING_TOKENS_THUMBNAIL=10000

# Caminho do diretório de skills do Claude
# Padrão: <raiz-do-projeto>/.claude/skills
# SKILLS_DIR=/opt/cortadorlive/.claude/skills

# -----------------------------------------------------------------------------
# MODELOS CLAUDE POR ETAPA                                    [opcional]
# -----------------------------------------------------------------------------
# Valores: opus | sonnet | haiku (ou nome completo do modelo)
CLAUDE_MODEL_ANALISE=opus
CLAUDE_MODEL_CENAS=sonnet
CLAUDE_MODEL_METADADOS=sonnet
CLAUDE_MODEL_THUMBNAIL=opus
CLAUDE_MODEL_RANKING_SENTIMENTO=haiku

# -----------------------------------------------------------------------------
# GERAÇÃO DE THUMBNAILS                                       [opcional]
# -----------------------------------------------------------------------------
# Janela de capas anteriores usadas como "elementos proibidos" no prompt
# para evitar repetição de roupa/cenário/paleta entre vídeos do canal.
THUMBNAIL_ANTI_REPETICAO_JANELA=8

# -----------------------------------------------------------------------------
# ANÁLISE DE TRANSCRIÇÃO                                      [opcional]
# -----------------------------------------------------------------------------
# Acima deste tamanho (em chars), a análise vai por lote.
# ~4 chars/token → 480000 chars ≈ 120k tokens (folga no contexto de 200k).
CLAUDE_ANALISE_MAX_CHARS_DIRETO=480000

# Ao gerar o bruto, gera cenas via Claude após re-sync da transcrição.
CLAUDE_AUTO_CENAS_NO_BRUTO=true

# -----------------------------------------------------------------------------
# RANKING DE LIVES CANDIDATAS                                 [opcional]
# -----------------------------------------------------------------------------
RANKING_JANELA_MESES_INICIAL=3
RANKING_JANELA_MESES_MAX=24
RANKING_TOP=20
RANKING_MAX_COMENTARIOS_POR_LIVE=30
RANKING_CACHE_HORAS=24.0
RANKING_MEIA_VIDA_DIAS=90.0

# Pesos do score de ranking (devem somar 1.0)
RANKING_PESO_VIEWS=0.15
RANKING_PESO_LIKES_POR_VIEW=0.10
RANKING_PESO_COMENTARIOS_POR_VIEW=0.15
RANKING_PESO_SENTIMENTO=0.35
RANKING_PESO_RECENCIA=0.25

# -----------------------------------------------------------------------------
# DEBUG / LOG                                                 [opcional]
# -----------------------------------------------------------------------------
# Imprime detalhamento completo do pipeline de geração de bruto no console.
# Mantenha false em produção para não poluir os logs.
BRUTO_VERBOSE_LOG=false
