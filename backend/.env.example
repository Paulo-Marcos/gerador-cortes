# CutCut — variáveis de ambiente do backend
#
# O bootstrap copia este arquivo para `backend/.env` (e nunca sobrescreve um que
# já exista). O .env guarda SEGREDOS. Identidade do canal, mascote, skills e
# ajustes do dia a dia ficam na tela Configurações, no banco, por canal
# (docs/adr/0012-onde-vive-cada-configuracao.md) — não aqui.
#
# Toda chave deste arquivo é um campo de `app/config.py` (um teste garante:
# tests/test_env_example_d676.py). A lista completa de ajustes, com o porquê
# de cada padrão, está lá.

# -----------------------------------------------------------------------------
# Segredos — todos opcionais: cada um libera uma parte do app
# -----------------------------------------------------------------------------

# Busca e ranking de lives (YouTube Data API v3, Google Cloud Console).
YOUTUBE_API_KEY=

# Cenas, desvios e imagens de capa pela API do Gemini (Google AI Studio).
GEMINI_API_KEY=

# Diarização de falantes: rotula quem fala em cada trecho. Precisa também de
# `pip install pyannote.audio` e dos termos aceitos no HuggingFace
# (passo a passo em docs/SETUP.md). Vazio = transcrição sem rótulo de falante.
HUGGINGFACE_TOKEN=

# -----------------------------------------------------------------------------
# Ajustes da máquina — descomente só se precisar (os valores são os padrões)
# -----------------------------------------------------------------------------

# Executáveis fora do lugar padrão (vazio = procura no PATH e nas pastas usuais).
# CLAUDE_CLI_PATH=
# AGY_CLI_PATH=
# CHROME_PATH=

# Porta local que recebe o retorno do login OAuth do YouTube; troque se outro
# programa a ocupar.
# YOUTUBE_OAUTH_PORT=8080

# Transcrição fiel dos shorts por ASR local (`pip install faster-whisper`).
# ASR_LOCAL_HABILITADO=false

# Detalha no log o pipeline de geração do bruto (para investigar problemas).
# BRUTO_VERBOSE_LOG=false
