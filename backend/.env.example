# Backend CortadorLive — variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores

# Gemini (para thumbnails)
GEMINI_API_KEY=

# Paths (relativos ao container ou ao diretório backend/)
# Para usar a estrutura de instância do canal, aponte para ../instance/projetos
# Exemplo: PROJETOS_DIR=../instance/projetos
PROJETOS_DIR=./projetos
ASSETS_DIR=./assets

# Identidade do canal (handle/nome/crédito) e canal-fonte das lives
# (youtube_channel_id) são configurados por canal no channel.yaml do canal
# ativo (pela UI de Canais) — não aqui.

# Nome do MASCOTE citado nos prompts de thumbnail/metadados. Semeia,
# no primeiro boot, o `editorial/mascote.yaml` do canal ativo SE ainda não tiver
# `nome` (idempotente, nunca sobrescreve). Deixe VAZIO para um mascote neutro
# ("mascote"). Alternativa: editar `instance/channels/<ativo>/editorial/mascote.yaml`.
CANAL_MASCOTE_NOME=
