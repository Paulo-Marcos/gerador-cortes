# Portas alternativas do dev.ps1 — copie para `dev.ports.local.ps1` (untracked)
# no checkout de DESENVOLVIMENTO.
#
# Por que: DEV e PROD (checkouts separados) rodam na mesma maquina. O PROD usa
# este arquivo? Nao — ele roda o dev.ps1 do repositorio, que ja vem com as
# portas de producao (8000 / 4300 / 3000 / 3001). Quem existe aqui e o DEV, que
# sobe em portas alternativas e para de disputar porta com o PROD ligado.
#
# O frontend recebe VITE_API_URL derivado de $BackendPort automaticamente, entao
# basta mexer nos numeros abaixo.

$BackendPort  = 8001
$FrontendPort = 4301
$RemotionPort = 3210
$WorkerPort   = 3011
