# Portas alternativas do dev.ps1 — copie para `dev.ports.local.ps1` (fora do git).
#
# Para quando duas instalações do app rodam na mesma máquina: sem este arquivo o
# dev.ps1 usa as portas padrão (backend 8000, frontend 4300, Remotion 3200), e a
# segunda instalação disputaria a porta com a primeira.
#
# O frontend recebe VITE_API_URL derivado de $BackendPort automaticamente, entao
# basta mexer nos numeros abaixo.

$BackendPort  = 8001
$FrontendPort = 4301
$RemotionPort = 3210
$WorkerPort   = 3011
