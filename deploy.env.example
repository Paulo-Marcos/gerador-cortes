# Copy this file to deploy.env and fill it in. NEVER commit deploy.env.
# (deploy.env is already listed in .gitignore.)
#
# Used by bin/deploy to build/push the backend image and bring the stack up
# on the deploy host via docker-compose.yml.

REGISTRY=registry.example.com      # e.g. a private Gitea/GHCR registry
IMAGE=gerador-cortes               # backend image name
VERSION=0.1.0                      # usually the release tag without the leading v
DEPLOY_HOST=server.example.com     # home server / VPS hostname or IP
DEPLOY_USER=deploy                 # non-root user with docker + ssh access
COMPOSE_DIR=/opt/gerador-cortes    # path to docker-compose.yml on the host
