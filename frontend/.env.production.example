# Variáveis de produção — copie este arquivo para .env.production e edite
# os valores com os dados do seu servidor e canal.
# NÃO versione o .env.production resultante (já está no .gitignore).

# URL base da API FastAPI — substitua pelo host real do backend em produção
VITE_API_URL=http://localhost:8000/api

# ─── Identidade do Canal ──────────────────────────────────────
# Handle do canal no YouTube (ex.: @meucanal)
VITE_CANAL_HANDLE=@seucanal
# Nome exibido do canal
VITE_CANAL_NOME=Seu Canal
