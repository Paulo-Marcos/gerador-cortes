# CutCut — variáveis de ambiente do frontend (lidas no build/dev do Vite)
#
# Normalmente você NÃO precisa deste arquivo: o `dev.ps1` já entrega ao Vite a
# URL do backend certo, derivada da porta configurada. Copie para `.env.local`
# só se for rodar o frontend sozinho (`npm run dev`) ou num worktree.

# URL da API. Sem ela, a base é relativa (`/api`) e as chamadas falham à vista,
# em vez de irem parar em outra instalação (D-623). Use a porta do SEU backend.
# VITE_API_URL=http://localhost:8000/api

# Handle que a busca de lives sugere ao abrir a tela.
# VITE_CANAL_HANDLE=@seucanal

# Mostra o mascote do canal sobre as cenas na prévia do editor.
# VITE_CANAL_MASCOTE_HABILITADO=false
