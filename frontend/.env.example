# URL base da API FastAPI. Padrão: http://localhost:8000/api
# Em produção, aponte para o host do backend.
VITE_API_URL=http://localhost:8000/api

# ─── Identidade do Canal ──────────────────────────────────────
# VITE_CANAL_HANDLE=@seucanal
# VITE_CANAL_NOME=Seu Canal

# ─── Mascote do Canal ─────────────────────────────────────────
# Mascote DESABILITADO por padrão (repo público sem mascote de canal).
# Coloque `true` para habilitar o mascote do seu canal (sobrepõe cenas com o PNG).
VITE_CANAL_MASCOTE_HABILITADO=false
